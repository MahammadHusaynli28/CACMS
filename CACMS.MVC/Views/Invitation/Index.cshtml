@model IEnumerable<ListInvitationDTO>
@{
    ViewData["Title"] = "My Invitations";
}

<h1>My Invitations</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>From</th>
                <th>Status</th>
                <th>Sent Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventTitle</td>
                    <td>@item.EventDate.ToString("g")</td>
                    <td>@item.PersonName</td>
                    <td>
                        <span class="badge bg-@(item.Status == "Pending" ? "warning" : item.Status == "Accepted" ? "success" : "danger")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.SentAt.ToString("g")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no invitations.
    </div>
}
