@model CreateInvitationDTO
@{
    ViewData["Title"] = "Send Invitation";
}

<h1>Send Invitation for @ViewData["EventTitle"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Person ID</label>
                <input type="text" class="form-control" asp-for="PersonId" placeholder="Enter the person's ID" />
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Send Invitation</button>
            <a asp-action="EventInvitations" asp-route-eventId="@ViewData["EventId"]" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
