@model IEnumerable<ListInvitationDTO>
@{
    ViewData["Title"] = "Event Invitations";
}

<h1>Invitations for @ViewData["EventTitle"]</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <a asp-action="Create" asp-route-eventId="@ViewData["EventId"]" class="btn btn-primary">+ Send Invitation</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Person</th>
                <th>Status</th>
                <th>Sent Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PersonName</td>
                    <td>
                        <span class="badge bg-@(item.Status == "Pending" ? "warning" : item.Status == "Accepted" ? "success" : "danger")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.SentAt.ToString("g")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No invitations sent yet.
    </div>
}

<a asp-controller="Event" asp-action="Details" asp-route-id="@ViewData["EventId"]" class="btn btn-secondary">Back to Event</a>
