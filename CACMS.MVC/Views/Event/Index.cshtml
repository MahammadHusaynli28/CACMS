@model IEnumerable<ListEventDTO>
@{
    ViewData["Title"] = "All Events";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1>Events</h1>
    </div>
    <div class="col-md-6 text-end">
        @if (User.IsInRole("Organizer"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Create Event</a>
        }
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">
                        <small>
                            <strong>Date:</strong> @item.Date.ToString("g")<br />
                            <strong>Location:</strong> @item.LocationName<br />
                            <strong>Type:</strong> @item.EventTypeName<br />
                            <strong>Capacity:</strong> @item.Capacity
                        </small>
                    </p>
                    <p class="card-text text-muted">
                        <small>Invitations: @item.InvitationCount</small>
                    </p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No events found.
    </div>
}
