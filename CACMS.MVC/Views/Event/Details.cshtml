@model GetEventDTO
@{
    ViewData["Title"] = Model.Title;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1>@Model.Title</h1>
    </div>
    <div class="col-md-4 text-end">
        @if (User.IsInRole("Organizer") && Model.OrganizerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Details</h5>
                <p><strong>Date:</strong> @Model.Date.ToString("g")</p>
                <p><strong>Location:</strong> @Model.LocationName</p>
                <p><strong>Event Type:</strong> @Model.EventTypeName</p>
                <p><strong>Organizer:</strong> @Model.OrganizerName</p>
                <p><strong>Capacity:</strong> @Model.Capacity</p>
                <p><strong>Created Date:</strong> @Model.CreatedDate.ToString("g")</p>
                <hr />
                <h6>Description</h6>
                <p>@Model.Description</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Statistics</div>
            <div class="card-body">
                <p><strong>Total Invitations:</strong> @Model.InvitationCount</p>
                <p><strong>Accepted:</strong> @Model.AcceptedCount</p>
                <p><strong>Participants:</strong> @Model.ParticipantCount</p>
            </div>
        </div>
        @if (User.IsInRole("Organizer") && Model.OrganizerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        {
            <div class="card mt-3">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <a asp-controller="Invitation" asp-action="EventInvitations" asp-route-eventId="@Model.Id" class="btn btn-sm btn-primary w-100 mb-2">Manage Invitations</a>
                    <a asp-controller="Invitation" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-sm btn-success w-100">Send Invitation</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
</div>
